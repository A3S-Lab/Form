suite "a3s-form-designer" {
    version = 1

    scenario "design-preview-submit" {
        name = "中文表单从设计到提交"
        surface = "web"
        timeout_ms = 60000

        navigate "open" {
            url = "http://127.0.0.1:4176/"
        }

        viewport "desktop" {
            width = 1440
            height = 1100
        }

        wait "ready" {
            text = "A3S Form · 表单设计器"
        }

        expect "designer-ready" {
            text = "● 编译通过"
        }

        click "add-number" {
            target = role("button", "添加数字字段")
        }

        fill "rename-number" {
            target = css("[aria-label='字段标题']")
            value = "工龄"
        }

        click "validation-settings" {
            target = css(".a3s-form-panel-tabs.is-inspector button:nth-child(2)")
        }

        expect "validation-ready" {
            visible = css("label.a3s-form-toggle")
        }

        click "require-number" {
            target = css("label.a3s-form-toggle:has(input[aria-label='必填字段'])")
        }

        click "open-structure" {
            target = role("button", "结构")
        }

        click "select-start-date" {
            target = role("treeitem", "选择入职日期")
        }

        click "start-date-validation" {
            target = css(".a3s-form-panel-tabs.is-inspector button:nth-child(2)")
        }

        expect "start-date-validation-ready" {
            visible = css("label.a3s-form-toggle")
        }

        click "optional-start-date" {
            target = css("label.a3s-form-toggle:has(input[aria-label='必填字段'])")
        }

        expect "field-updated" {
            text = "工龄"
        }

        click "preview" {
            target = role("button", "预览")
        }

        expect "preview-updated" {
            text = "工龄"
        }

        click "submit-empty" {
            target = css(".a3s-form-renderer button[type='submit']")
        }

        expect "required-validation" {
            text = "此项为必填项。"
        }

        fill "name" {
            target = css("[id$='-name']")
            value = "张三"
        }

        fill "invalid-email" {
            target = css("[id$='-email']")
            value = "invalid-email"
        }

        select "department" {
            target = css("[id$='-department']")
            values = ["engineering"]
        }

        fill "years" {
            target = css("[id$='-field-1']")
            value = "3"
        }

        click "submit-invalid-email" {
            target = css(".a3s-form-renderer button[type='submit']")
        }

        expect "email-validation" {
            text = "请输入有效的电子邮箱。"
        }

        fill "valid-email" {
            target = css("[id$='-email']")
            value = "zhangsan@example.com"
        }

        click "submit-valid" {
            target = css(".a3s-form-renderer button[type='submit']")
        }

        expect "submitted" {
            text = "申请已提交，正在等待审批。"
        }

        click "save-draft" {
            target = role("button", "保存草稿")
        }

        expect "draft-saved" {
            text = "草稿已保存。"
        }

        click "design" {
            target = role("button", "设计")
        }

        click "open-components" {
            target = role("button", "组件")
        }

        click "select-root" {
            target = css(".a3s-form-page-heading")
        }

        click "add-two-columns" {
            target = role("button", "添加两栏布局")
        }

        expect "first-column" {
            visible = css("[data-node-id='column-1']")
        }

        expect "second-column" {
            visible = css("[data-node-id='column-2']")
        }

        drag "field-into-column" {
            source = css("[aria-label='添加单行文本字段']")
            target = css("[aria-label='插入到column-1第1位']")
        }

        expect "field-in-column" {
            visible = css("[data-node-id='column-1'] .a3s-form-design-field")
        }

        click "select-root-again" {
            target = css(".a3s-form-page-heading")
        }

        click "add-tabs" {
            target = role("button", "添加标签页")
        }

        click "second-tab" {
            target = role("tab", "标签页 2")
        }

        click "save-document" {
            target = role("button", "保存表单")
        }

        expect "document-saved" {
            text = "已保存"
        }
    }
}
