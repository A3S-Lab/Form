{
  "name": "@a3s-lab/form",
  "version": "0.1.0",
  "description": "AI Native Form Designer and deterministic form runtime for A3S products.",
  "keywords": [
    "form-designer",
    "json-schema",
    "ai-native",
    "react",
    "vue",
    "web-components"
  ],
  "homepage": "https://github.com/A3S-Lab/Form#readme",
  "bugs": {
    "url": "https://github.com/A3S-Lab/Form/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A3S-Lab/Form.git"
  },
  "license": "MIT",
  "author": "A3S Lab",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "import": "./dist/cloud.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./compiler.worker.js": "./dist/workers/compiler.worker.js",
    "./wasm/sha256.wasm": "./dist/wasm/sha256.wasm",
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "a3s-form": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills/a3s-form",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun scripts/build.mjs && tsc -p tsconfig.build.json",
    "wasm:build": "bun scripts/build-wasm.mjs",
    "wasm:benchmark": "bun scripts/benchmark-wasm.mjs",
    "dev": "rsbuild dev --config apps/playground/rsbuild.config.ts",
    "playground:build": "rsbuild build --config apps/playground/rsbuild.config.ts",
    "playground:preview": "rsbuild preview --config apps/playground/rsbuild.config.ts --host 127.0.0.1 --port 4176 --strict-port",
    "docs:dev": "rspress -c apps/docs/rspress.config.ts",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:preview": "rspress preview -c apps/docs/rspress.config.ts",
    "serve": "node scripts/serve-playground.mjs",
    "typecheck": "tsc --noEmit",
    "test": "rstest run",
    "test:cli": "node scripts/smoke-cli.mjs",
    "test:coverage": "node node_modules/@rstest/core/bin/rstest.js run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run test:cli && bun run playground:build && bun run docs:build"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20",
    "vue": ">=3.4.0 <4"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@rsbuild/core": "2.1.9",
    "@rsbuild/plugin-react": "2.1.0",
    "@rspress/core": "2.0.17",
    "@rstest/core": "0.10.6",
    "@rstest/coverage-v8": "0.10.6",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.10.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "vue": "3.5.27"
  },
  "dependencies": {
    "@a3s-lab/ui": "0.2.0"
  }
}
